# Required for real chat and PDF embedding
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local Qdrant URL in Docker Compose; use http://localhost:6333 when running locally
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=pdf_support_chunks

# Retrieval tuning. Similarity scores are not calibrated probabilities.
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MIN_RELEVANCE_SCORE=0.18

# API config
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
